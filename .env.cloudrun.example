APP_ENV=production
SECRET_KEY=replace-with-a-long-random-secret
PUBLIC_BASE_URL=https://your-cloud-run-or-custom-domain

# Cloud SQL PostgreSQL. Use the Cloud SQL Unix socket path when configured.
# Example socket form:
# postgresql+psycopg2://USER:PASSWORD@/DBNAME?host=/cloudsql/PROJECT:REGION:INSTANCE
DATABASE_URL=postgresql+psycopg2://USER:PASSWORD@/DBNAME?host=/cloudsql/PROJECT:REGION:INSTANCE

# Cloudflare R2
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key
R2_SECRET_ACCESS_KEY=your_r2_secret_key
R2_BUCKET=hub-academy-materials
R2_PRESIGN_EXPIRES_SECONDS=3600

# Stripe
STRIPE_SECRET_KEY=sk_live_or_test_key
STRIPE_WEBHOOK_SECRET=whsec_webhook_secret
STRIPE_MONTHLY_PRICE_ID=price_monthly_subscription
STRIPE_ANNUAL_PRICE_ID=price_annual_subscription
SUBSCRIPTION_MONTHLY_PRICE=29
SUBSCRIPTION_ANNUAL_PRICE=249
DEFAULT_CURRENCY=USD

# Optional AI assistant
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_AUDIO_MODEL=gpt-4o-mini-tts
OPENAI_VOICE=alloy

# Password reset email
MAIL_SERVER=mail.privateemail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USE_SSL=false
MAIL_USERNAME=academy@hubacademy.ai
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=academy@hubacademy.ai

# Optional D-ID video avatar
DID_API_KEY=
DID_SOURCE_IMAGE_URL=
